{
  "name": "dsh-weixin-player",
  "version": "0.1.0",
  "private": true,
  "description": "DeepSeek Harness 微信渠道：把微信长轮询消息接进 DSH 会话，把 agent 回复发回微信。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\""
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "ilink_appid": "bot",
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.7.0"
  }
}
